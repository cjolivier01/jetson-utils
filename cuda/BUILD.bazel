# HIP (ROCm) build of CUDA kernels using hipcc. Enabled with:
#   bazel build --define=jetson_use_hip=true //cuda:hip_cuda_lib

filegroup(
    name = "hip_cuda_srcs",
    srcs = [
        "cudaBayer.cu",
        "cudaPointCloud.cu",
        "cudaCrop.cu",
        "cudaDraw.cu",
        "cudaFilterMode.cu",
        "cudaFont.cu",
        "cudaNormalize.cu",
        "cudaOverlay.cu",
        "cudaResize.cu",
        "cudaResizeRoi.cu",
        "cudaWarp-affine.cu",
        "cudaWarp-fisheye.cu",
        "cudaWarp-intrinsic.cu",
        "cudaWarp-perspective.cu",
        "cudaColormap.cu",
        "cudaGrayscale.cu",
        "cudaRGB.cu",
        "cudaYUV-NV12.cu",
        "cudaYUV-YUYV.cu",
        "cudaYUV-YV12.cu",
    ],
)

genrule(
    name = "hip_cuda_lib_gen",
    srcs = [":hip_cuda_srcs"] + [
        # headers to ensure they are in the sandbox during compilation
        "cudaAlphaBlend.cuh",
        "cudaFilterMode.cuh",
        "cudaMisc.cuh",
        "cudaColormap.h",
        "cudaFilterMode.h",
        "cudaGrayscale.h",
        "cudaRGB.h",
        "cudaWarp.h",
        "cudaBayer.h",
        "cudaCrop.h",
        "cudaDraw.h",
        "cudaFont.h",
        "cudaMappedMemory.h",
        "cudaNormalize.h",
        "cudaOverlay.h",
        "cudaPointCloud.h",
        "cudaResize.h",
        "cudaResizeRoi.h",
        "cudaVector.h",
        "cudaMath.h",
        "cudaUtility.h",
        "cudaColorspace.h",
        "cuda_runtime_compat.h",
        "cuda_gl_interop_shim.h",
        "//base:base_hdrs",
        "//image:image_hdrs",
    ],
    outs = ["libhip_cuda_kernels.a"],
    tools = ["@rocm_sdk_includes//:hipcc"],
    cmd = (
        "set -e; mkdir -p $(@D)/hipobjs; " +
        "for s in $(SRCS); do " +
        "  case \"$$s\" in *.cu) b=$$(basename $$s); o=$(@D)/hipobjs/$${b%.*}.o; repo_root=$$(dirname $$s)/..; " +
        "    $(location @rocm_sdk_includes//:hipcc) -c --std=c++17 -fPIC -O2 -DJETSON_USE_HIP " +
        "    -I$$repo_root -I$$repo_root/cuda -I$$repo_root/base -I$$repo_root/image -I$$repo_root/display -I$$repo_root/threads -I$$repo_root/video -I$$repo_root/codec -I$$repo_root/network -I$$repo_root/python -I$$repo_root/python/bindings " +
        "    $$s -o $$o; " +
        "  esac; " +
        "done; " +
        "ar rcs $@ $(@D)/hipobjs/*.o"
    ),
    tags = ["no-sandbox"],
    visibility = ["//visibility:public"],
    toolchains = [],
    target_compatible_with = select({
        ":use_hip": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)

cc_import(
    name = "hip_cuda_lib",
    static_library = ":hip_cuda_lib_gen",
    visibility = ["//visibility:public"],
    alwayslink = True,
    target_compatible_with = select({
