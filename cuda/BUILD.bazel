            "-Xcompiler=-O0",
            "-Xcompiler=-g",
            "-G",
            "-g",
            "-keep",
            "-O0",
        ],
        # in all other modes, no extra flags
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
    deps = [
        ":cuda_lib_headers",
        ":cuda_math",
        "//image:image_format",
        "@local_cuda//:cuda_runtime",
