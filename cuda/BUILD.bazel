load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_cuda//cuda:defs.bzl", "cuda_library")

INCLUDE_PREFIX = "jetson-utils/cuda"

config_setting(
    name = "aarch64-linux-gnu",
    constraint_values = ["@platforms//cpu:aarch64"],
)

config_setting(
    name = "x86_64-linux-gnu",
    constraint_values = ["@platforms//cpu:x86_64"],
)

config_setting(
    name = "debug_build",
    values = {"compilation_mode": "dbg"},
)

cc_library(
    name = "cuda_lib",
    srcs = [
        "cudaPointCloud.cpp",
    ],
    copts = [
        "-fopenmp",
        "-Wall",
        "-std=c++17",
        "-fPIC",
        "-Wno-error=deprecated-declarations",
        # "-g",
        # "-O0",
    ],
    include_prefix = INCLUDE_PREFIX,
    linkopts = select({
        ":aarch64-linux-gnu": [
            "-L/usr/local/cuda/targets/aarch64-linux/lib",
            "-L/usr/lib/aarch64-linux-gnu/nvidia",
        ],
        ":x86_64-linux-gnu": ["-L/usr/local/cuda/targets/x86_64-linux/lib"],
        "//conditions:default": [],
    }) + [
        "-lnppig_static",
        "-lnppc_static",
        "-lnppif_static",
        "-lnppicc_static",
        # "-lnvbufsurface",
        # "-lnvbufsurftransform",
        "-lculibos",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":colorspace_lib",
        ":cuda_cuda_lib",
        "//display:display_includes",
        "//display:gl_buffer",
        "//display:gl_utility",
    ],
)

cc_library(
    name = "colorspace_lib",
    srcs = [
        "cudaColorspace.cpp",
    ],
    hdrs = [
        "cudaColorspace.h",
    ],
    copts = [
        "-fopenmp",
        "-Wall",
        "-std=c++17",
        "-fPIC",
        "-Wno-error=deprecated-declarations",
    ],
    include_prefix = INCLUDE_PREFIX,
    linkopts = select({
        ":aarch64-linux-gnu": [
            "-L/usr/local/cuda/targets/aarch64-linux/lib",
            "-L/usr/lib/aarch64-linux-gnu/nvidia",
        ],
        ":x86_64-linux-gnu": ["-L/usr/local/cuda/targets/x86_64-linux/lib"],
        "//conditions:default": [],
    }) + [
        "-lnppig_static",
        "-lnppc_static",
        "-lnppif_static",
        "-lnppicc_static",
        #"-lnvbufsurface",
        #"-lnvbufsurftransform",
        "-lculibos",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":colorspace_cuda_lib",
        ":cuda_bayer",
        "//display:display_includes",
        "//display:gl_buffer",
        "//display:gl_utility",
        "//image:image_format",
    ],
)

cuda_library(
    name = "cuda_cuda_lib",
    srcs = [
        "cudaCrop.cu",
        "cudaDraw.cu",
        "cudaFilterMode.cu",
        "cudaFont.cu",
        "cudaNormalize.cu",
        "cudaOverlay.cu",
        "cudaPointCloud.cu",
        "cudaResize.cu",
        "cudaResizeRoi.cu",
        "cudaWarp-affine.cu",
        "cudaWarp-fisheye.cu",
        "cudaWarp-intrinsic.cu",
    ],
    hdrs = [
        "cudaAlphaBlend.cuh",
    ],
    copts = [
        "-Xcompiler=-fPIC",
        "-Xcompiler=-std=c++17",
        "-Wno-deprecated-gpu-targets",
        "-Xcompiler=-fdiagnostics-color=always",
    ] + select({
        # only in debug mode:
        ":debug_build": [
            "-Xcompiler=-O0",
            "-Xcompiler=-g",
            "-G",
            "-g",
            "-keep",
            "-O0",
        ],
        # in all other modes, no extra flags
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
    deps = [
        ":cuda_utility",
        ":colorspace_cuda_lib",
        ":cuda_lib_headers",
        "//image:stb_image",
        "@local_cuda//:cuda_runtime",
    ],
)

cuda_library(
    name = "colorspace_cuda_lib",
    srcs = [
        "cudaColormap.cu",
        "cudaGrayscale.cu",
        "cudaRGB.cu",
        "cudaYUV-NV12.cu",
