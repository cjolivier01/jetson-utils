inline __attribute__((device)) __attribute__((host)) float smoothstep(float a, float b, float x)
{
    float y = clamp((x - a) / (b - a), 0.0f, 1.0f);
    return (y*y*(3.0f - (2.0f*y)));
}
inline __attribute__((device)) __attribute__((host)) float2 smoothstep(float2 a, float2 b, float2 x)
{
