}





inline __attribute__((host)) __attribute__((device)) float2 normalize(float2 v)
{
    float invLen = rsqrtf(dot(v, v));
    return v * invLen;
}
inline __attribute__((host)) __attribute__((device)) float3 normalize(float3 v)
{
    float invLen = rsqrtf(dot(v, v));
    return v * invLen;
}
inline __attribute__((host)) __attribute__((device)) float4 normalize(float4 v)
{
    float invLen = rsqrtf(dot(v, v));
