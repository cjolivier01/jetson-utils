inline __attribute__((host)) __attribute__((device)) float length(float2 v)
{
    return sqrtf(dot(v, v));
}
inline __attribute__((host)) __attribute__((device)) float length(float3 v)
{
    return sqrtf(dot(v, v));
}
inline __attribute__((host)) __attribute__((device)) float length(float4 v)
{
