load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_cuda//cuda:defs.bzl", "cuda_library")

config_setting(
    name = "aarch64-linux-gnu",
    constraint_values = ["@platforms//cpu:aarch64"],
)

config_setting(
    name = "x86_64-linux-gnu",
    constraint_values = ["@platforms//cpu:x86_64"],
)

cc_library(
    name = "stitch",
    srcs = ["cudaMat.cpp"],
    hdrs = [
        "cudaMat.h",
        "cudaMat.inl",
    ],
    includes = ["."],
    visibility = ["//visibility:public"],
    deps = [
        ":cuda_blend_cuda_lib",
        "//image",
        # TODO: remove opencv dependency
        "@opencv_linux//:opencv",
    ],
)

cuda_library(
    name = "cuda_blend_cuda_lib",
    srcs = [
        "cudaBlend.cu",
        "cudaMakeFull.cu",
        "cudaRemap.cu",
    ],
    hdrs = [
        "cudaBlend.h",
        "cudaMakeFull.h",
        "cudaRemap.h",
    ],
    copts = [
        "-std=c++17",
        "-Xcompiler=-fPIC",
        "-Xcompiler=-g",
        "-Xcompiler=-O0",
        "-Xcompiler=-rdynamic",
        "-G",
        "-keep",
        "-g",
        "-O0",
    ],
    includes = ["."],
    visibility = ["//visibility:private"],
    deps = [
        "//cuda:colorspace_cuda_lib",
        "//cuda:cuda_lib_headers",
        "//image",
        "@local_cuda//:cuda_runtime",
    ],
)
