  "version": "0.2.0",
  "configurations": [
    {
      "name": "----------------- jetson-utils -----------------",
    },
    {
      //
      // Python: Current File
      //
      "name": "Python: Current File",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "args": [],
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceRoot}/build:${workspaceRoot}/src:${workspaceRoot}/external/MOTChallengeEvalKit"
      }
    },
    {
      "name": "gl-display-test",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/bazel-bin/display/gl-display-test/gl_display_test",
      "args": [],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "JU Build All",
    },
    {
      "name": "(LLDB) cudaBlend",
      "type": "lldb",
      "request": "launch",
      "linux": {
        // "envFile": "${workspaceFolder}/${config:mesonbuild.buildFolder}/meson-vscode.env",
      },
      "cwd": "${workspaceFolder}",
      "program": "${workspaceFolder}/bazel-bin/stitch/test/test_cuda_blend",
      "args": [
        //"stitch-fix",
        "mlk-heat-1",
        "${workspaceRoot}/output.png",
      ],
      "sourceMap": {
        "/proc/self/cwd": "${workspaceFolder}",
        "~/src": "${env:HOME}/src",
        "external/deepstream/sources": "${env:HOME}/src/hstream/external/deepstream/sources",
        "home/colivier/src/jetson-utils": "${workspaceFolder}/src/external/jetson-utils",
      },
      //"stopOnEntry": true,
      "env": {
        // "LD_LIBRARY_PATH": "${env:HOME}/src/hstream/lib:${env:HOME}/src/hstream/external/deepstream/lib:/opt/nvidia/deepstream/deepstream/lib:${env:HOME}/miniforge3/envs/ubuntu/lib",
        // "GST_PLUGIN_PATH": "${env:HOME}/src/hstream/lib/gst-plugins:${env:HOME}/src/hstream/external/deepstream/lib/gst-plugins:/opt/nvidia/deepstream/deepstream/lib/gst-plugins",
        "DISPLAY": ":1",
        "CUDA_LAUNCH_BLOCKING": "1",
      },
      "preLaunchTask": "JU Build All",
    },
    {
      "name": "(CUDA) cudaBlend",
      "type": "cuda-gdb",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "debuggerPath": "/usr/local/cuda/bin/cuda-gdb",
      "program": "${workspaceFolder}/bazel-bin/stitch/test/test_cuda_blend",
      "args": "mlk-heat-1 ${workspaceRoot}/output.png",
      "initCommands": [
        "directory ${workspaceFolder}",
      ],
      // "environment": [
      //   {
      //     "name": "GST_PLUGIN_PATH",
      //     "value": "${env:HOME}/src/hstream/lib/gst-plugins:${env:HOME}/src/hstream/external/deepstream/lib/gst-plugins:/opt/nvidia/deepstream/deepstream/lib/gst-plugins"
      //   },
      //   {
      //     "name": "DISPLAY",
      //     "value": ":1",
      //   },
      // ],
      // "additionalSOLibSearchPath": "${env:HOME}/src/hstream/external/deepstream/lib:/opt/nvidia/deepstream/deepstream/lib:${env:HOME}/miniforge3/envs/ubuntu/lib:${env:HOME}/miniforge3/envs/ubuntu/lib/x86_64-linux-gnu",
      "preLaunchTask": "JU Build All",
    },
  ]
}
