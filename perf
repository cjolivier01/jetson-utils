#!/bin/bash

set -euo pipefail

source "$(dirname "$0")/toolchain_env.sh"

CPU="$(uname -m)"
if [ "$CPU" == "x86_64" ]; then
  CPU="k8"
fi

ensure_python_env
ensure_cuda_env
ensure_rocm_env || true

BAZEL_ARGS=(
	"--config=opt"
	"--cpu=${CPU}"
)

if detect_glibc_conflict; then
  BAZEL_ARGS+=("--define=glibc_math_rsqrt_conflict=1")
fi

bazelisk build "${BAZEL_ARGS[@]}" "--repo_env=PYTHON_BIN_PATH=${PYTHON_BIN_PATH}" "$@" //...
